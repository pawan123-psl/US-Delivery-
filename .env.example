# Copy this file to .env and fill in your real values.
# NEVER commit the .env file to version control.
# Committing a real API key is an automatic disqualifier.

# ── Required ──────────────────────────────────────────────────────────────────
# Groq API key — get yours free at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── Optional ──────────────────────────────────────────────────────────────────
# Model to use (Groq-hosted). Default: llama-3.3-70b-versatile
# GROQ_MODEL=llama-3.3-70b-versatile

# DATA_DIR is auto-detected — no need to set this manually.
# The repo includes a bundled data/ folder that is used automatically.
# Only set this if you want to use a custom data location.
# DATA_DIR=./data
