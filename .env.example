# Copy this file to .env and fill in your real values.
# NEVER commit the .env file to version control.
# Committing a real API key is an automatic disqualifier.

# ── LLM ──────────────────────────────────────────────────────────────────────
# Groq API key — get yours free at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Model to use (Groq-hosted)
GROQ_MODEL=llama-3.3-70b-versatile

# ── Data paths ────────────────────────────────────────────────────────────────
# Path to the starter-repo data directory (relative to Task-1 project root)
DATA_DIR=../Task/resources/starter-repo
